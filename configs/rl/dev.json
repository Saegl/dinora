{
    "opening_noise_moves": 15,
    "dirichlet_alpha": 0.4,
    "noise_fraction": 0.4,

    "cpuct": 4.0,

    "generations": 2,
    "games_per_generation": 12,
    "epochs_per_generation": 1,
    "nodes_per_move": 10,

    "upload_pgn": true,
    "pgn_chunk_games_size": 10000,
    "window_games_size": 500000,

    "batch_size_train": 128,
    "batch_size_selfplay": 4,
    "learning_rate": 0.001,

    "enable_cploss": true,
    "cploss_label": "saegl/dinora-chess/elite_cploss:latest",
    "cploss_batch_size": 2048,
    "cploss_positions": 3500,

    "selfplay_log_interval": 5,
    "selfplay_num_batch_workers": 4,
    "selfplay_cuda_devices": [
        "cuda:0"
    ],

    "upload_model": false,
    "model_conf": {
        "res_channels": 128,
        "res_blocks": 7,
        "policy_channels": 32,
        "value_channels": 8,
        "value_lin_channels": 128
    }
}
